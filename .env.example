# ── Database (dipakai Prisma) — taruh di .env ──────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Connector API — taruh di .env.local (tidak ikut git) ───────────────────
# Lihat README → "Setup Connector" untuk langkah lengkap.

# Kunci enkripsi untuk token OAuth yang disimpan di DB (AES-256-GCM).
# Buat dengan: openssl rand -base64 32
ENCRYPTION_KEY=

# Auth Google — pilih salah satu (atau keduanya; service account didahulukan):
# Opsi 1: service account (butuh admin GA4/GSC untuk menambahkan email-nya).
#         Path ke file JSON kunci. Simpan di luar folder project, jangan di-commit. Kosongkan jika pakai opsi 2.
GOOGLE_APPLICATION_CREDENTIALS=
# Opsi 2: login akun Google kamu (OAuth client tipe "Web application"). Dipakai juga untuk YouTube.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opsional; default http://localhost:3000/api/auth/google/callback (harus terdaftar di OAuth client)
# GOOGLE_OAUTH_REDIRECT_URI=

# GA4: Property ID (angka), GA4 → Admin → Property details. Bukan Measurement ID G-XXXX.
GA4_PROPERTY_ID=

# Search Console: persis seperti di GSC, mis. sc-domain:mainkekudus.com (properti Domain) atau https://mainkekudus.com/
GSC_SITE_URL=

# YouTube: memakai GOOGLE_OAUTH_CLIENT_ID/SECRET di atas (login akun pemilik channel di halaman Connectors).

# Meta Graph API (Instagram & Facebook) — lihat README → Setup Connector → Meta.
# Token system user (Business Settings → Users → System users → Generate new token, expiration: Never).
META_ACCESS_TOKEN=
# ID Page Facebook Main ke Kudus (angka). Dipakai untuk post Facebook & mencari akun IG otomatis.
META_PAGE_ID=
# Opsional: ID akun Instagram bisnis (angka 1784…). Kosongkan → diambil dari Page (instagram_business_account).
META_IG_USER_ID=
# Opsional: App secret, wajib jika app Meta mengaktifkan "Require App Secret" (appsecret_proof).
META_APP_SECRET=

# Sync otomatis saat server Next jalan (npm run dev / start): 1 = aktif.
# Bulan lalu, tiap tanggal 3 jam 07:00 WIB; dikejar saat server menyala jika terlewat.
SYNC_CRON=0
