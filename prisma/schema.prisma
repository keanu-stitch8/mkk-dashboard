// Schema dashboard MKK.
// Sengaja hanya pakai tipe portable (String, Int, Float, DateTime) tanpa enum/Json
// supaya bisa dipindah ke PostgreSQL cukup dengan mengganti `provider`.
// Tanggal harian disimpan sebagai String "YYYY-MM-DD" dan bulan sebagai "YYYY-MM".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Satu file/dataset yang di-import untuk satu bulan.
/// (month, source) unik → import ulang = replace (child rows ikut terhapus via cascade).
model Import {
  id        String   @id @default(cuid())
  month     String
  source    String // dataset key, mis. ga4_traffic, gsc_queries, meta_instagram
  fileName  String
  rowCount  Int
  note      String?
  createdAt DateTime @default(now())

  metrics      Metric[]
  breakdowns   Breakdown[]
  ga4Channels  Ga4Channel[]
  ga4Pages     Ga4Page[]
  ga4Landings  Ga4Landing[]
  gscQueries   GscQuery[]
  gscPages     GscPage[]
  gscDaily     GscDaily[]
  ytVideos     YtVideo[]
  ytDaily      YtDaily[]
  ytLogs       YtLog[]
  socialPosts  SocialPost[]
  socialLogs   SocialLog[]
  newsArticles NewsArticle[]
  newsViews    NewsView[]

  @@unique([month, source])
  @@index([month])
}

/// Angka total hasil import (mis. users dari GA4 overview, total row YouTube).
model Metric {
  id       String @id @default(cuid())
  importId String
  month    String
  channel  String // website | news | youtube | social
  key      String
  value    Float
  import   Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month, channel])
}

/// Input manual (fallback / override) per bulan.
model ManualMetric {
  id        String   @id @default(cuid())
  month     String
  channel   String
  key       String
  value     Float
  updatedAt DateTime @updatedAt

  @@unique([month, channel, key])
}

/// Kuota bulanan. month = "default" untuk nilai default, atau "YYYY-MM" untuk override.
model Quota {
  id    String @id @default(cuid())
  month String
  key   String // news | youtube | ig_reels | ig_carousel | ...
  value Float

  @@unique([month, key])
}

/// Breakdown generik format panjang (kota, device, negara, new users per channel, dst).
model Breakdown {
  id        String @id @default(cuid())
  importId  String
  month     String
  channel   String
  dimension String
  label     String
  metric    String
  value     Float
  import    Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month, channel, dimension])
}

model Ga4Channel {
  id                 String @id @default(cuid())
  importId           String
  month              String
  channel            String
  sessions           Float
  engagedSessions    Float?
  engagementRate     Float? // pecahan 0–1
  avgEngagementTime  Float? // detik per sesi
  eventCount         Float?
  users              Float?
  newUsers           Float?
  import             Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model Ga4Page {
  id                String @id @default(cuid())
  importId          String
  month             String
  path              String // path ternormalisasi (atau judul jika export per judul)
  title             String?
  views             Float
  activeUsers       Float?
  avgEngagementTime Float? // detik per active user
  eventCount        Float?
  import            Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month, path])
}

model Ga4Landing {
  id                String @id @default(cuid())
  importId          String
  month             String
  path              String
  sessions          Float
  activeUsers       Float?
  newUsers          Float?
  avgEngagementTime Float?
  import            Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model GscQuery {
  id          String @id @default(cuid())
  importId    String
  month       String
  query       String
  clicks      Float
  impressions Float
  ctr         Float // pecahan 0–1
  position    Float
  import      Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model GscPage {
  id          String @id @default(cuid())
  importId    String
  month       String
  url         String
  path        String
  clicks      Float
  impressions Float
  ctr         Float
  position    Float
  import      Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model GscDaily {
  id          String @id @default(cuid())
  importId    String
  month       String
  date        String
  clicks      Float
  impressions Float
  ctr         Float
  position    Float
  import      Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model YtVideo {
  id                 String  @id @default(cuid())
  importId           String
  month              String
  videoId            String
  title              String
  publishedDate      String?
  durationSec        Float?
  views              Float
  watchHours         Float?
  avgViewDurationSec Float?
  impressions        Float?
  ctr                Float? // pecahan 0–1
  uniqueViewers      Float?
  subsGained         Float?
  subsLost           Float?
  likes              Float?
  comments           Float?
  shares             Float?
  import             Import  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model YtDaily {
  id         String @id @default(cuid())
  importId   String
  month      String
  date       String
  watchHours Float?
  views      Float?
  import     Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Publishing log YouTube (Google Sheets / report XLSX).
model YtLog {
  id       String  @id @default(cuid())
  importId String
  month    String
  date     String?
  title    String
  url      String?
  videoId  String?
  format   String?
  category String?
  status   String // publish | review | draft | lainnya
  import   Import  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Post dari export Meta Business Suite (Instagram / Facebook).
model SocialPost {
  id           String @id @default(cuid())
  importId     String
  month        String
  platform     String // instagram | facebook
  /// username akun pemilik post (post kolaborasi bisa milik akun lain)
  account      String?
  postId       String
  date         String
  publishedAt  String // "YYYY-MM-DD HH:mm"
  format       String // reels | carousel | feeds | video | photo | story | lainnya
  rawType      String?
  caption      String?
  permalink    String?
  views        Float?
  reach        Float?
  likes        Float?
  comments     Float?
  shares       Float?
  saves        Float?
  follows      Float?
  interactions Float?
  durationSec  Float?
  import       Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month, platform])
}

/// Publishing log sosmed (Google Sheets).
model SocialLog {
  id       String  @id @default(cuid())
  importId String
  month    String
  date     String?
  platform String
  format   String
  category String?
  admin    String?
  designer String?
  status   String
  title    String?
  url      String?
  import   Import  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Artikel dari News Content Logs.
model NewsArticle {
  id            String  @id @default(cuid())
  importId      String
  month         String
  date          String?
  submittedDate String?
  title         String
  url           String?
  path          String?
  category      String?
  reporter      String?
  status        String // publish | review | draft | lainnya
  type          String?
  method        String?
  import        Import  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Views per artikel yang sudah dihitung di report News (fallback jika GA4 Pages belum di-import).
model NewsView {
  id                String @id @default(cuid())
  importId          String
  month             String
  path              String
  views             Float
  activeUsers       Float?
  avgEngagementTime Float?
  import            Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Kredensial connector yang didapat lewat OAuth (mis. refresh token YouTube).
/// `data` = JSON terenkripsi AES-256-GCM (lib/crypto.ts) dengan ENCRYPTION_KEY.
model ConnectorCredential {
  id        String   @id @default(cuid())
  connector String   @unique // ga4 | gsc | youtube | meta
  data      String
  account   String? // label akun yang terhubung (mis. nama channel)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Riwayat sync connector API.
model SyncLog {
  id         String    @id @default(cuid())
  connector  String // ga4 | gsc | youtube | meta
  month      String // YYYY-MM
  status     String // running | success | error
  rows       Int       @default(0)
  /// ringkasan dataset yang disimpan, mis. "GA4 · Traffic acquisition: 7 baris"
  detail     String?
  /// pesan error yang sudah diterjemahkan (Bahasa Indonesia)
  error      String?
  /// error asli dari API (untuk debugging)
  rawError   String?
  trigger    String    @default("manual") // manual | script | cron
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([connector, month])
  @@index([startedAt])
}

/// Impressions & CTR thumbnail harian per video dari YouTube Reporting API (laporan "Reach").
/// Disimpan permanen karena laporan di API hanya tersedia 60 hari.
model YtReachDaily {
  id          String @id @default(cuid())
  date        String // YYYY-MM-DD (hari laporan, zona Pacific)
  videoId     String
  impressions Float
  ctr         Float // pecahan 0–1

  @@unique([date, videoId])
  @@index([date])
}

/// Laporan Reporting API yang sudah diunduh (supaya tidak diunduh ulang).
model YtReachReport {
  id        String   @id // id laporan dari API
  date      String // hari yang dicakup
  createdAt DateTime @default(now())
}

/// Snapshot metrik lifetime post Instagram (post 90 hari terakhir), diambil maks. 1x per hari saat sync Meta.
/// Selisih dua snapshot = performa post di antara keduanya (dasar views per post per bulan — opsi B).
/// Disimpan permanen (tidak terhapus saat sync ulang), seperti YtReachDaily.
model IgMediaSnapshot {
  id            String   @id @default(cuid())
  date          String // YYYY-MM-DD (WIB) saat snapshot diambil
  mediaId       String
  publishedDate String // YYYY-MM-DD (WIB)
  format        String
  views         Float?
  reach         Float?
  likes         Float?
  comments      Float?
  shares        Float?
  saves         Float?
  interactions  Float?
  createdAt     DateTime @default(now())

  @@unique([date, mediaId])
  @@index([date])
}
