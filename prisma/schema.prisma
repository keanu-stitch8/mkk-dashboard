// Schema dashboard MKK.
// Sengaja hanya pakai tipe portable (String, Int, Float, DateTime) tanpa enum/Json
// supaya bisa dipindah ke PostgreSQL cukup dengan mengganti `provider`.
// Tanggal harian disimpan sebagai String "YYYY-MM-DD" dan bulan sebagai "YYYY-MM".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Satu file/dataset yang di-import untuk satu bulan.
/// (month, source) unik → import ulang = replace (child rows ikut terhapus via cascade).
model Import {
  id        String   @id @default(cuid())
  month     String
  source    String // dataset key, mis. ga4_traffic, gsc_queries, meta_instagram
  fileName  String
  /** link file sumber (mis. Google Sheets log) — untuk halaman Sumber Logs */
  fileUrl   String?
  rowCount  Int
  note      String?
  createdAt DateTime @default(now())

  metrics      Metric[]
  breakdowns   Breakdown[]
  ga4Channels  Ga4Channel[]
  ga4Pages     Ga4Page[]
  ga4Landings  Ga4Landing[]
  gscQueries   GscQuery[]
  gscPages     GscPage[]
  gscDaily     GscDaily[]
  ytVideos     YtVideo[]
  ytDaily      YtDaily[]
  ytLogs       YtLog[]
  socialPosts  SocialPost[]
  socialLogs   SocialLog[]
  newsArticles NewsArticle[]
  newsViews    NewsView[]

  @@unique([month, source])
  @@index([month])
}

/// Angka total hasil import (mis. users dari GA4 overview, total row YouTube).
model Metric {
  id       String @id @default(cuid())
  importId String
  month    String
  channel  String // website | news | youtube | social
  key      String
  value    Float
  import   Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month, channel])
}

/// Input manual (fallback / override) per bulan.
model ManualMetric {
  id        String   @id @default(cuid())
  month     String
  channel   String
  key       String
  value     Float
  updatedAt DateTime @updatedAt

  @@unique([month, channel, key])
}

/// Kuota bulanan. month = "default" untuk nilai default, atau "YYYY-MM" untuk override.
model Quota {
  id    String @id @default(cuid())
  month String
  key   String // news | youtube | ig_reels | ig_carousel | ...
  value Float

  @@unique([month, key])
}

/// Breakdown generik format panjang (kota, device, negara, new users per channel, dst).
model Breakdown {
  id        String @id @default(cuid())
  importId  String
  month     String
  channel   String
  dimension String
  label     String
  metric    String
  value     Float
  import    Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month, channel, dimension])
}

model Ga4Channel {
  id                 String @id @default(cuid())
  importId           String
  month              String
  channel            String
  sessions           Float
  engagedSessions    Float?
  engagementRate     Float? // pecahan 0–1
  avgEngagementTime  Float? // detik per sesi
  eventCount         Float?
  users              Float?
  newUsers           Float?
  import             Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model Ga4Page {
  id                String @id @default(cuid())
  importId          String
  month             String
  path              String // path ternormalisasi (atau judul jika export per judul)
  title             String?
  views             Float
  activeUsers       Float?
  avgEngagementTime Float? // detik per active user
  eventCount        Float?
  import            Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month, path])
}

model Ga4Landing {
  id                String @id @default(cuid())
  importId          String
  month             String
  path              String
  sessions          Float
  activeUsers       Float?
  newUsers          Float?
  avgEngagementTime Float?
  import            Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model GscQuery {
  id          String @id @default(cuid())
  importId    String
  month       String
  query       String
  clicks      Float
  impressions Float
  ctr         Float // pecahan 0–1
  position    Float
  import      Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model GscPage {
  id          String @id @default(cuid())
  importId    String
  month       String
  url         String
  path        String
  clicks      Float
  impressions Float
  ctr         Float
  position    Float
  import      Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model GscDaily {
  id          String @id @default(cuid())
  importId    String
  month       String
  date        String
  clicks      Float
  impressions Float
  ctr         Float
  position    Float
  import      Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model YtVideo {
  id                 String  @id @default(cuid())
  importId           String
  month              String
  videoId            String
  title              String
  publishedDate      String?
  durationSec        Float?
  views              Float
  watchHours         Float?
  avgViewDurationSec Float?
  impressions        Float?
  ctr                Float? // pecahan 0–1
  uniqueViewers      Float?
  subsGained         Float?
  subsLost           Float?
  likes              Float?
  comments           Float?
  shares             Float?
  import             Import  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

model YtDaily {
  id         String @id @default(cuid())
  importId   String
  month      String
  date       String
  watchHours Float?
  views      Float?
  import     Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Publishing log YouTube (Google Sheets / report XLSX).
model YtLog {
  id       String  @id @default(cuid())
  importId String
  month    String
  date     String?
  title    String
  url      String?
  videoId  String?
  format   String?
  category String?
  /// nama Video Editor dari tab Tracker (Gantt), dicocokkan lewat nama video
  editor   String?
  status   String // publish | review | draft | lainnya
  import   Import  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Post dari export Meta Business Suite (Instagram / Facebook).
model SocialPost {
  id           String @id @default(cuid())
  importId     String
  month        String
  platform     String // instagram | facebook
  /// username akun pemilik post (post kolaborasi bisa milik akun lain)
  account      String?
  postId       String
  date         String
  publishedAt  String // "YYYY-MM-DD HH:mm"
  format       String // reels | carousel | feeds | video | photo | story | lainnya
  rawType      String?
  caption      String?
  permalink    String?
  views        Float?
  reach        Float?
  likes        Float?
  comments     Float?
  shares       Float?
  saves        Float?
  follows      Float?
  interactions Float?
  durationSec  Float?
  import       Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month, platform])
}

/// Publishing log sosmed (Google Sheets).
model SocialLog {
  id       String  @id @default(cuid())
  importId String
  month    String
  date     String?
  platform String
  format   String
  category String?
  admin    String?
  designer String?
  status   String
  title    String?
  url      String?
  /// kode liputan dari kolom Story (opsional), mis. "261022-1"
  story    String?
  import   Import  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Artikel dari News Content Logs.
model NewsArticle {
  id            String  @id @default(cuid())
  importId      String
  month         String
  date          String?
  submittedDate String?
  title         String
  url           String?
  path          String?
  category      String?
  reporter      String?
  status        String // publish | review | draft | lainnya
  type          String?
  method        String?
  /// kode liputan dari kolom Story (opsional), mis. "261022-1"
  story         String?
  import        Import  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Views per artikel yang sudah dihitung di report News (fallback jika GA4 Pages belum di-import).
model NewsView {
  id                String @id @default(cuid())
  importId          String
  month             String
  path              String
  views             Float
  activeUsers       Float?
  avgEngagementTime Float?
  import            Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([month])
}

/// Kredensial connector yang didapat lewat OAuth (mis. refresh token YouTube).
/// `data` = JSON terenkripsi AES-256-GCM (lib/crypto.ts) dengan ENCRYPTION_KEY.
model ConnectorCredential {
  id        String   @id @default(cuid())
  connector String   @unique // ga4 | gsc | youtube | meta
  data      String
  account   String? // label akun yang terhubung (mis. nama channel)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Riwayat sync connector API.
model SyncLog {
  id         String    @id @default(cuid())
  connector  String // ga4 | gsc | youtube | meta
  month      String // YYYY-MM
  status     String // running | success | error
  rows       Int       @default(0)
  /// ringkasan dataset yang disimpan, mis. "GA4 · Traffic acquisition: 7 baris"
  detail     String?
  /// pesan error yang sudah diterjemahkan (Bahasa Indonesia)
  error      String?
  /// error asli dari API (untuk debugging)
  rawError   String?
  trigger    String    @default("manual") // manual | script | cron
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([connector, month])
  @@index([startedAt])
}

/// Impressions & CTR thumbnail harian per video dari YouTube Reporting API (laporan "Reach").
/// Disimpan permanen karena laporan di API hanya tersedia 60 hari.
model YtReachDaily {
  id          String @id @default(cuid())
  date        String // YYYY-MM-DD (hari laporan, zona Pacific)
  videoId     String
  impressions Float
  ctr         Float // pecahan 0–1

  @@unique([date, videoId])
  @@index([date])
}

/// Laporan Reporting API yang sudah diunduh (supaya tidak diunduh ulang).
model YtReachReport {
  id        String   @id // id laporan dari API
  date      String // hari yang dicakup
  createdAt DateTime @default(now())
}

/// Snapshot metrik lifetime post Instagram (post 90 hari terakhir), diambil maks. 1x per hari saat sync Meta.
/// Selisih dua snapshot = performa post di antara keduanya (dasar views per post per bulan — opsi B).
/// Disimpan permanen (tidak terhapus saat sync ulang), seperti YtReachDaily.
model IgMediaSnapshot {
  id            String   @id @default(cuid())
  date          String // YYYY-MM-DD (WIB) saat snapshot diambil
  mediaId       String
  publishedDate String // YYYY-MM-DD (WIB)
  format        String
  views         Float?
  reach         Float?
  likes         Float?
  comments      Float?
  shares        Float?
  saves         Float?
  interactions  Float?
  createdAt     DateTime @default(now())

  @@unique([date, mediaId])
  @@index([date])
}

/// Story Instagram yang tayang — dari API (diambil selagi aktif ≤24 jam) atau import CSV Story Business Suite.
/// Hanya info (termasuk repost); kuota & KPI Story tetap dari Publishing Log.
model IgStory {
  storyId     String   @id // ID media IG (sama di API & kolom "Post ID" CSV)
  month       String
  date        String // YYYY-MM-DD (WIB)
  publishedAt String // "YYYY-MM-DD HH:mm" (WIB)
  permalink   String?
  durationSec Float?
  views       Float?
  reach       Float?
  linkClicks  Float?
  source      String // api | csv
  updatedAt   DateTime @updatedAt

  @@index([month])
}

/// Bulan yang sudah final: connector metrik (GA4, GSC, YouTube, Meta) tidak boleh menarik ulang bulan ini
/// supaya angka laporan tidak berubah (metrik lifetime per post terus bertambah). Publishing Log tetap bisa di-sync.
model MonthLock {
  month    String   @id
  lockedAt DateTime @default(now())
  note     String?
}

/// Insight akun IG selama bulan itu, dipecah per jenis konten (breakdown media_product_type) — angka per periode,
/// tidak berubah saat sync ulang. type: REEL | CAROUSEL_CONTAINER | POST | STORY | …
model IgAccountByType {
  month     String
  metric    String // views | reach | total_interactions
  type      String
  value     Float
  updatedAt DateTime @updatedAt

  @@id([month, metric, type])
}

/// Laporan bulanan yang dibuat dashboard (file Google Sheets baru dari master template).
model GeneratedReport {
  id        String   @id @default(cuid())
  channel   String // website | news | youtube | social
  month     String // YYYY-MM
  fileId    String?
  url       String?
  /// PDF seluruh workbook (A4 landscape) di folder Drive yang sama
  pdfFileId String?
  pdfUrl    String?
  status    String // success | error
  trigger   String // manual | cron
  warnings  String?
  error     String?
  createdAt DateTime @default(now())

  @@index([channel, month])
}

/// Active users GA4 per kota + negara selama bulan itu (per periode, stabil). Dipakai laporan untuk
/// menyaring kota di luar Indonesia (sering crawler/data center) & "(not set)" dari peringkat kota.
model Ga4City {
  month       String
  city        String
  country     String
  activeUsers Float
  newUsers    Float?
  updatedAt   DateTime @updatedAt

  @@id([month, city, country])
  @@index([month])
}

/// Cache metadata halaman web per URL (og:image = thumbnail artikel di Publishing Log News).
/// ogImage null = halaman sudah dicek tapi tidak punya og:image (atau gagal diambil; dicoba ulang setelah 7 hari).
model PageMeta {
  url       String   @id
  ogImage   String?
  fetchedAt DateTime @default(now())
}

/// Rencana artikel dari panduan liputan harian (Drive: "YYMMDD_PANDUAN LIPUTAN WAWANCARA SHOTLIST.docx").
/// Satu "Artikel N" = satu Story; code = "YYMMDD-N" dipakai sebagai kunci liputan di seluruh tahap.
model Story {
  code      String   @id
  date      String // YYYY-MM-DD (tanggal panduan)
  month     String
  n         Int
  title     String
  angle     String?
  fileId    String
  fileName  String
  updatedAt DateTime @updatedAt

  @@index([month])
}

/// Brief turunan (carousel / reel) dari Content & Creative (Drive: "YYMMDD_Brief Carousel - Topik.docx").
model Brief {
  fileId       String  @id
  fileName     String
  date         String // YYYY-MM-DD dari nama file
  month        String
  type         String // carousel | reel | lainnya
  topic        String
  /// judul utama / cover (Judul: …), dasar pencocokan dengan post IG
  headline     String?
  /// outline per slide/scene, satu baris per item: "S1 · Cover · Judul"
  outline      String?
  webViewLink  String?
  modifiedTime String?
  updatedAt    DateTime @updatedAt

  @@index([month])
}

/// Pasangan antar tahap (Story → artikel, Brief → artikel / post IG). Ditebak otomatis dari judul:
/// auto = sangat yakin, suggested = ambigu (TIDAK dihitung sampai dikonfirmasi), confirmed / rejected = keputusan tim
/// (dipertahankan saat pencocokan diulang; rejected tidak disarankan lagi).
model TeamMatch {
  id        String   @id @default(cuid())
  fromType  String // story | brief | igstory
  fromKey   String // Story.code | Brief.fileId | kunci log IG story
  toType    String // article | social | story
  /// kunci stabil target: URL jika ada, selain itu "tanggal|format|judul"
  toKey     String
  toTitle   String
  toDate    String?
  toFormat  String?
  toUrl     String?
  score     Float
  status    String // dibuat mesin: coded | tracker | auto | suggested · keputusan tim: confirmed | rejected
  /// nama dari sesi login saat Confirm / Not this
  decidedBy String?
  decidedAt DateTime?
  updatedAt DateTime @updatedAt

  @@unique([fromType, fromKey, toType, toKey])
  @@index([fromType, fromKey])
}

/// Baris "Social Media - Task Progress" (tracker editor) yang menyebut file brief. Diganti utuh setiap sync.
/// Status & link IG di sini ditulis tim, jadi dipakai sebagai bukti — tapi link ke post log tetap harus cocok judulnya.
model BriefTask {
  briefKey  String   @id // nama file brief yang dinormalkan (lihat briefKey di lib/team/parse.ts)
  briefName String
  tab       String // bulan tab, YYYY-MM
  planned   String?
  article   String?
  format    String
  status    String? // huruf kecil: published, reviewing, submitted, unpublished, …
  assignee  String?
  submitted String?
  published String?
  igUrl     String?
  note      String? // isi kolom Instagram Link yang bukan URL, mis. "Unpublished by client"
  updatedAt DateTime @updatedAt
}

/// Baris "Local Contributor - Task Progress": satu rencana liputan kontributor lokal + kelengkapan asetnya.
/// Diganti utuh setiap sync. Aset: available | missing | null (belum diisi).
model ContributorTask {
  id          String   @id // "<tab>#<No>"
  tab         String // YYYY-MM
  no          Int
  planned     String?
  guideFile   String?
  n           Int
  title       String
  status      String?
  articleBy   String?
  articleAt   String?
  landscape   String?
  landscapeBy String?
  landscapeAt String?
  portrait    String?
  portraitBy  String?
  portraitAt  String?
  video       String?
  videoBy     String?
  videoAt     String?
  interview   String?
  interviewBy String?
  interviewAt String?
  /// kode Story jika judulnya cocok dengan rencana artikel di panduan hari itu (tanpa tebakan)
  storyCode   String?
  updatedAt   DateTime @updatedAt

  @@index([tab])
}

/// Alias kontributor (tab Ref) → nama lengkap.
model Contributor {
  alias String @id
  name  String
}

/// Snapshot Team Scorecard saat bulan dikunci (angka tidak berubah lagi walau pasangan dikonfirmasi belakangan).
/// Bulan yang belum punya snapshot dihitung live.
model TeamScore {
  month     String
  key       String
  value     Float?
  /// pembilang & penyebut untuk ukuran berbentuk rasio (mis. 10 dari 24 artikel) — supaya bisa dijumlah setahun
  n         Int?
  base      Int?
  detail    String?
  createdAt DateTime @default(now())

  @@id([month, key])
}
